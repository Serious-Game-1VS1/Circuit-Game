# Copia a /etc/circuitsync/arbitro.env (instalar.sh lo hace si no existe) y reemplaza los marcadores.
# Formato systemd: sin comillas ni "export". NO subas este archivo con valores reales.

# App ID de la app Photon "Realtime" (panel de Photon). Obligatorio.
PHOTON_APP_ID=<PEGA_AQUI>
# Region Photon; debe ser la misma que usa el cliente (VITE_PHOTON_REGION). US East = us.
PHOTON_REGION=us

# Salas simultaneas maximas (3 CCU por sala; plan gratis = 20 CCU). Por defecto 6.
MAX_SALAS=6
# Duracion de la partida en minutos (1 a 30). Quita el # para demo de 5 min; por defecto 12.
#LIMITE_MIN=5
# Nivel de pods: 1, 2 o mixto (por defecto mixto).
#NIVEL=mixto
# Semilla fija (entero 0..2^32-1). Dejar vacia = aleatoria. No la pongas vacia: comentala.
#SEMILLA=<PEGA_AQUI>
# Modo demo: 1 = cableado, radar = solo Radar. Comentado = juego normal.
#DEMO=1

# Panel docente: carpeta de datos (por defecto spike/data/docente)
DOCENTE_DATA=/var/lib/circuitsync/docente
# Usuario y hash de contrasena del panel docente. Solo si usas el panel (ver spike/DOCENTE-CONTRATO.md);
# serve.ts no las lee (verificar: las usa otro componente del panel).
#DOCENTE_USER=<PEGA_AQUI>
#DOCENTE_PASS_HASH=<PEGA_AQUI>
