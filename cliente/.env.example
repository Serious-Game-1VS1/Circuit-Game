# Copia este archivo a .env.local (ignorado por git) y completa los valores.
# App ID de Photon Realtime: es público (viaja en el cliente), pero no se versiona.
VITE_PHOTON_APP_ID=
# Región de Photon Cloud; vacío = us. Debe coincidir con PHOTON_REGION del árbitro (spike/.env).
VITE_PHOTON_REGION=
# photon | local. Vacío: photon si hay App ID; si no, el relé local (npm run serve en spike/).
VITE_TRANSPORT=
